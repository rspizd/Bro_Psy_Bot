MODEL_NAME = "deepseek/deepseek-chat"
MAX_TELEGRAM_MESSAGE_LENGTH = 4000
MAX_HISTORY_MESSAGES = 10
ROLE_STORE_PATH = Path(__file__).resolve().parents[2] / "roles.json"
